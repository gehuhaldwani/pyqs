---
import { ClientRouter } from "astro:transitions";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import siteConfig from "@/configs/site.config";
import { addBaseUrl } from "@/utils/site-url";
import { formatPageTitle } from "@/utils/string";
import Fonts from "./Fonts.astro";

interface Props {
	title?: string;
	description?: string;
	ogImageUrl?: URL;
	transition?: boolean;
	// Disables pinch-zoom on pages with their own zoom controls, such as the PDF viewer.
	lockZoom?: boolean;
	// Origins the page fetches from early, such as the host of a PDF.
	preconnect?: string[];
	// Turn off on pages that should not load AdSense, such as the PDF viewer.
	ads?: boolean;
}

export type { Props };

const {
	title: pageTitle,
	description = siteConfig.site.description,
	ogImageUrl = new URL(addBaseUrl(siteConfig.site.logo), Astro.url.origin),
	transition = true,
	lockZoom = false,
	preconnect = [],
	ads = true,
} = Astro.props;

const viewport = lockZoom
	? "width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
	: "width=device-width, initial-scale=1.0";

const title = formatPageTitle(siteConfig.site.title, pageTitle);
---

<meta charset="UTF-8" />
<meta name="viewport" content={viewport} />
<!-- Matches the page background. Media queries follow the OS theme, not the site's toggle. -->
<meta
	name="theme-color"
	content="#fafafa"
	media="(prefers-color-scheme: light)"
/>
<meta
	name="theme-color"
	content="#0a0a0a"
	media="(prefers-color-scheme: dark)"
/>

<meta name="ads" content={ads ? "on" : "off"} />
{ads && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
{preconnect.map((origin) => <link rel="preconnect" href={origin} />)}

<title>{title}</title>
<meta name="description" content={description} />
<meta name="url" content={Astro.url.href} />
<meta name="robots" content="index,follow" />
<meta name="language" content="EN" />

<link rel="sitemap" href={addBaseUrl("/sitemap-index.xml")} />
<meta name="generator" content={Astro.generator} />

<meta property="og:title" content={title} />
<meta property="og:site_name" content={siteConfig.site.title} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<link rel="icon" href={addBaseUrl(siteConfig.site.favicon)} />

{transition && <ClientRouter fallback="none" />}

<ThemeInitScript />

<script>
	import { haptics, defaultPatterns } from "@/lib/haptics";

	document.addEventListener("astro:before-preparation", () => {
		haptics.trigger(defaultPatterns.selection);
	});
</script>

<script is:inline>
	// This script is the same on every page, so client-side navigation never re-runs it.
	// It loads AdSense once, on the first page whose ads meta is "on", and then fills ad slots on each page load.
	if (!window.__pyqsAds) {
		window.__pyqsAds = { loaded: false };

		const adsEnabled = () =>
			document.querySelector('meta[name="ads"]')?.content === "on";

		const loadAdSense = () => {
			if (window.__pyqsAds.loaded || !adsEnabled()) return;
			window.__pyqsAds.loaded = true;
			const script = document.createElement("script");
			script.async = true;
			script.crossOrigin = "anonymous";
			script.src =
				"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9523971842257474";
			document.head.append(script);
		};

		// Start the download while the first page is still parsing, as the old <script> tag did.
		loadAdSense();

		document.addEventListener("astro:page-load", () => {
			if (!adsEnabled()) return;
			loadAdSense();
			document
				.querySelectorAll("ins.adsbygoogle:not([data-adsbygoogle-status])")
				.forEach(() => {
					(window.adsbygoogle = window.adsbygoogle || []).push({});
				});
		});
	}
</script>

<Fonts />
