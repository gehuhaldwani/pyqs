---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { linkAttributes } from "@/utils/site-url";

interface Props extends Omit<HTMLAttributes<"a">, "href" | "target" | "rel"> {
	// A site path such as "/about", or a full URL when `external` is set.
	href: string;
	// Opens in a new tab and uses `href` as is, without the site's base path.
	external?: boolean;
	externalIcon?: boolean;
}

const {
	href,
	external = false,
	externalIcon = false,
	class: className,
	...rest
} = Astro.props;
---

<a
	{...linkAttributes(href, external)}
	class:list={["link-base", className]}
	{...rest}
>
	<slot />
	{
		external && externalIcon && (
			<Icon name="mdi:arrow-top-right" class="size-3" aria-hidden="true" />
		)
	}
</a>
