---
import { base } from "astro:config/server";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Dropdown from "@/components/starwind/dropdown";
import ThemeToggle from "@/components/starwind/theme-toggle/ThemeToggle.astro";
import FocusTimer from "@/components/widgets/FocusTimer.astro";
import siteConfig from "@/configs/site.config";
import { linkAttributes } from "@/utils/site-url";
import NavLink from "./NavLink.astro";

interface Props extends HTMLAttributes<"header"> {}

const { class: className, ...props } = Astro.props;
---

<!-- The height is fixed at --header-h, which bars that stick below it rely on. -->
<header class:list={["sticky top-0 z-40 h-(--header-h) px-3 pt-3 sm:px-6", className]} {...props}>
	<div
		class="mx-auto flex max-w-6xl h-14 items-center justify-between gap-3 rounded-full border bg-card/90 pr-2 pl-3 shadow-soft backdrop-blur-md sm:pl-4"
	>
		<a href={base} class="group flex items-center gap-2.5 rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-outline">
			<span
				class="grid size-9 -rotate-6 place-items-center rounded-xl bg-brand-yellow font-excalifont text-xl text-sticky-ink shadow-soft transition-transform motion-safe:group-hover:rotate-6"
				aria-hidden="true">P</span
			>
			<span class="hidden text-lg font-extrabold tracking-tight whitespace-nowrap min-[400px]:inline md:text-xl">{siteConfig.site.title}</span>
			<span class="sr-only min-[400px]:hidden">{siteConfig.site.title}</span>
		</a>

		<div class="flex flex-row items-center gap-2">
			<nav class="hidden flex-row items-center gap-1 md:flex" aria-label="Main">
				{
					siteConfig.header.links.map((link) => (
						<NavLink
							href={link.url}
							external={link.type === "external"}
							class="rounded-full px-3 py-2 text-sm font-medium hover:bg-accent hover:no-underline"
						>
							{link.name}
						</NavLink>
					))
				}
			</nav>

			<FocusTimer />

			<ThemeToggle
				variant="outline"
				size="md"
				class="rounded-full"
				transition:name="theme-toggle"
				data-haptic
			/>

			<Dropdown.Root class="inline md:hidden">
				<Dropdown.Trigger
					class="flex size-10 items-center justify-center rounded-full bg-foreground text-background"
					aria-label="Menu"
				>
					<Icon name="mdi:menu" class="size-5" aria-hidden="true" />
				</Dropdown.Trigger>
				<Dropdown.Content align="end" class="rounded-2xl">
					{
						siteConfig.header.links.map((link) => (
							<Dropdown.LinkItem
								closeOnClick
								class="rounded-xl"
								{...linkAttributes(link.url, link.type === "external")}
							>
								{link.name}
							</Dropdown.LinkItem>
						))
					}
				</Dropdown.Content>
			</Dropdown.Root>
		</div>
	</div>
</header>

<script>
	import { haptic } from "@/lib/haptics";

	// Astro elements can't take Svelte attachments, so controls opt in with data-haptic.
	// ClientRouter swaps in a new header on each page, so this runs again after every swap.
	const ready = new WeakSet<HTMLElement>();
	document.addEventListener("astro:page-load", () => {
		for (const el of document.querySelectorAll<HTMLElement>("[data-haptic]")) {
			if (ready.has(el)) continue;
			ready.add(el);
			haptic(el);
		}
	});
</script>
