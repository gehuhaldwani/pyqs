---
import { base } from "astro:config/server";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Dropdown from "@/components/starwind/dropdown";
import ThemeToggle from "@/components/starwind/theme-toggle/ThemeToggle.astro";
import siteConfig from "@/configs/site.config";
import { linkAttributes } from "@/utils/site-url";
import NavLink from "./NavLink.astro";

interface Props extends HTMLAttributes<"header"> {}

const { class: className, ...props } = Astro.props;
---

<header class:list={["border-b font-excalifont", className]} {...props}>
	<div
		class="h-full flex items-center justify-between max-w-7xl mx-auto px-10 py-2"
	>
		<div class="text-xl md:text-2xl font-bold">
			<a href={base} class="link-base">{siteConfig.site.title}</a>
		</div>

		<div class="flex flex-row items-center gap-4">
			<nav class="hidden sm:flex flex-row gap-3">
				{
					siteConfig.header.links.map((link) => (
						<NavLink href={link.url} external={link.type === "external"}>
							{link.name}
						</NavLink>
					))
				}
			</nav>

			<ThemeToggle
				variant="default"
				size="md"
				transition:name="theme-toggle"
			/>

			<Dropdown.Root class="inline sm:hidden">
				<Dropdown.Trigger class="flex items-center justify-center" aria-label="Menu">
					<Icon name="mdi:menu" class="w-5 h-full" aria-hidden="true" />
				</Dropdown.Trigger>
				<Dropdown.Content align="end">
					{
						siteConfig.header.links.map((link) => (
							<Dropdown.LinkItem
								closeOnClick
								{...linkAttributes(link.url, link.type === "external")}
							>
								{link.name}
							</Dropdown.LinkItem>
						))
					}
				</Dropdown.Content>
			</Dropdown.Root>
		</div>
	</div>
</header>
