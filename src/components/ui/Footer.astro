---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import siteConfig, { SOCIALS } from "@/configs/site.config";
import { formatBuildTime } from "@/utils/date";
import GithubButton from "../widgets/GithubButton.astro";
import Doodle from "./Doodle.astro";
import NavLink from "./NavLink.astro";

interface Props extends HTMLAttributes<"footer"> {}

const { class: className, ...props } = Astro.props;

const builtAt = new Date();
---

<!-- AdSense Auto ads skip elements that already have this status, so it keeps ads out of the footer. -->
<footer
	data-adsbygoogle-status="done"
	class:list={["mt-16 rounded-t-[2.5rem] border-t border-white/10 bg-[#1c1c1e] text-white", className]}
	{...props}
>
	<div class="relative mx-auto h-full w-full max-w-6xl px-6 py-12 sm:px-10">
		<Doodle name="squiggle" class="absolute top-6 right-10 hidden w-32 text-brand-yellow sm:block" />
		<div class="grid grid-cols-1 gap-10 md:grid-cols-3">
			<div class="md:col-span-2">
				<div class="inline-block -rotate-1 rounded-2xl bg-sticky-yellow px-5 py-4 text-sticky-ink shadow-lift">
					<p class="text-lg">
						Maintained by <span class="font-excalifont text-xl">{siteConfig.footer.maintainer.name}</span>
					</p>
					<p class="font-excalifont text-sm opacity-80">
						{siteConfig.footer.maintainer.designation}
					</p>
				</div>

				<p class="mt-6">
					<NavLink
						class="inline-flex items-center gap-1 rounded-full bg-white px-4 py-2 font-semibold text-sticky-ink hover:bg-brand-yellow hover:no-underline"
						href={siteConfig.footer.maintainer.support}
						external
						externalIcon
					>
						Support my work
					</NavLink>
				</p>

				<div class="mt-6 flex gap-4 text-white/80" data-footer-socials>
					{
						SOCIALS.map((social) => (
							<NavLink href={social.url} external aria-label={social.name}>
								<Icon name={social.iconify} class="social-icon" aria-hidden="true" />
							</NavLink>
						))
					}
				</div>
				<p class="mt-6 max-w-prose text-white/70">{siteConfig.site.description}</p>
			</div>
			<div>
				<h2 class="font-excalifont text-xl text-brand-yellow">Quick links</h2>
				<ul class="mt-3 space-y-2 text-white/80">
					<li>
						<GithubButton />
					</li>
					{
						siteConfig.footer.links.map((link) => (
							<li>
								<NavLink
									href={link.url}
									external={link.type === "external"}
									externalIcon
									class="inline-flex items-center gap-1 hover:text-white"
								>
									{link.name}
								</NavLink>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="mt-12 flex flex-col items-center gap-1 border-t border-white/10 pt-6 text-sm text-white/60">
			<p>
				Built with <NavLink
					href="https://astro.build"
					external
					class="text-white hover:decoration-2"
					aria-label="Astro"
				>
					<Icon name="astro" class="inline" aria-hidden="true" />
				</NavLink>
			</p>
			<p>
				Last updated on <span
					class="font-excalifont text-white/80"
					data-footer-built-at={builtAt.toISOString()}
					data-timezone={siteConfig.site.timezone}
					>{formatBuildTime(builtAt, siteConfig.site.timezone)}</span
				>
			</p>
		</div>
	</div>
</footer>

<script>
	// Incremental builds can reuse this page's HTML from an older build, so the build time and socials above may be stale.
	// This script replaces them with the values in build-info.json, which every build regenerates.
	import { BUILD_INFO_PATH, type BuildInfo } from "@/lib/build-info";
	import { formatBuildTime } from "@/utils/date";
	import { addBaseUrl } from "@/utils/site-url";
	import { EXTERNAL_LINK_ATTRIBUTES } from "@/utils/url";

	let buildInfo: Promise<BuildInfo | null> | undefined;

	// The client router keeps this module loaded between pages, so the file is fetched once per visit.
	function loadBuildInfo() {
		buildInfo ??= fetch(addBaseUrl(BUILD_INFO_PATH), { cache: "no-cache" })
			.then((res) => (res.ok ? (res.json() as Promise<BuildInfo>) : null))
			.catch(() => null);
		return buildInfo;
	}

	function renderSocialLink(social: BuildInfo["socials"][number]) {
		// Same attributes as <NavLink external> in the markup above.
		const link = document.createElement("a");
		link.href = social.url;
		link.target = EXTERNAL_LINK_ATTRIBUTES.target;
		link.rel = EXTERNAL_LINK_ATTRIBUTES.rel;
		link.setAttribute("aria-label", social.name);
		// The SVG markup comes from this site's own build output, so innerHTML is safe here.
		link.innerHTML = social.svg;
		link.firstElementChild?.setAttribute("class", "social-icon");
		link.firstElementChild?.setAttribute("aria-hidden", "true");
		return link;
	}

	async function refreshFooter() {
		const info = await loadBuildInfo();
		if (!info) return;

		const builtAt = document.querySelector<HTMLElement>("[data-footer-built-at]");
		if (builtAt && builtAt.dataset.footerBuiltAt !== info.builtAt) {
			builtAt.dataset.footerBuiltAt = info.builtAt;
			builtAt.textContent = formatBuildTime(
				new Date(info.builtAt),
				builtAt.dataset.timezone ?? "Asia/Kolkata",
			);
		}

		const socials = document.querySelector<HTMLElement>("[data-footer-socials]");
		if (socials && info.socials.length > 0) {
			socials.replaceChildren(...info.socials.map(renderSocialLink));
		}
	}

	document.addEventListener("astro:page-load", refreshFooter);
</script>
