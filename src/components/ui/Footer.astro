---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import siteConfig, { SOCIALS } from "@/configs/site.config";
import { formatBuildTime } from "@/utils/date";
import GithubButton from "../widgets/GithubButton.astro";
import NavLink from "./NavLink.astro";

interface Props extends HTMLAttributes<"footer"> {}

const { class: className, ...props } = Astro.props;

const builtAt = new Date();
---

<footer
	data-adsbygoogle-status="done"
	class:list={["border-t bg-muted", className]}
	{...props}
>
	<div class="h-full w-full max-w-7xl mx-auto p-10">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			<div class="col-span-2">
				<p class="text-xl">
					Maintained by <span class="font-excalifont"
						>{siteConfig.footer.maintainer.name}</span
					>
				</p>
				<p class="text-lg font-medium">
					(<span class="font-excalifont"
						>{siteConfig.footer.maintainer.designation}</span
					>)
				</p>

				<p class="text-lg font-medium">
					<NavLink
						class="font-excalifont link-support flex"
						href={siteConfig.footer.maintainer.support}
						external
						externalIcon
					>
						Support my work
					</NavLink>
				</p>
				<br />
				<div
					class="flex gap-4 mt-3"
					data-footer-socials
				>
					{
						SOCIALS.map((social) => (
							<NavLink href={social.url} external aria-label={social.name}>
								<Icon name={social.iconify} class="social-icon" />
							</NavLink>
						))
					}
				</div>
				<br />
				<p>{siteConfig.site.description}</p>
			</div>
			<div class="col-span-1">
				<p class="text-lg font-medium mb-2">Quick Links</p>
				<ul class="font-excalifont">
					<li>
						<GithubButton />
					</li>
					{
						siteConfig.footer.links.map((link) => (
							<li class="my-2">
								<NavLink
									href={link.url}
									external={link.type === "external"}
									externalIcon
									class="flex link-muted"
								>
									{link.name}
								</NavLink>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<br />
		<p class="w-full text-center">
			Built with <NavLink
				href="https://astro.build"
				external
				class="underline"
				aria-label="Astro"
			>
				<Icon name="astro" class="inline" />
			</NavLink>
		</p>
		<p class="w-full text-center">
			Last updated on <span
				class="font-excalifont"
				data-footer-built-at={builtAt.toISOString()}
				data-timezone={siteConfig.site.timezone}
				>{formatBuildTime(builtAt, siteConfig.site.timezone)}</span
			> (IST)
		</p>
	</div>
</footer>

<script>
	// With incremental builds, a page's HTML can be reused from an older build,
	// so the build time and socials rendered above may be stale. Refresh them
	// from build-info.json, which is regenerated on every build.
	import { BUILD_INFO_PATH, type BuildInfo } from "@/lib/build-info";
	import { formatBuildTime } from "@/utils/date";
	import { addBaseUrl } from "@/utils/site-url";
	import { EXTERNAL_LINK_ATTRIBUTES } from "@/utils/url";

	let buildInfo: Promise<BuildInfo | null> | undefined;

	// Fetched once per visit; the client router keeps this module alive across navigations.
	function loadBuildInfo() {
		buildInfo ??= fetch(addBaseUrl(BUILD_INFO_PATH), { cache: "no-cache" })
			.then((res) => (res.ok ? (res.json() as Promise<BuildInfo>) : null))
			.catch(() => null);
		return buildInfo;
	}

	function renderSocialLink(social: BuildInfo["socials"][number]) {
		// Mirrors <NavLink external> in the markup above
		const link = document.createElement("a");
		link.href = social.url;
		link.target = EXTERNAL_LINK_ATTRIBUTES.target;
		link.rel = EXTERNAL_LINK_ATTRIBUTES.rel;
		link.setAttribute("aria-label", social.name);
		// SVG markup comes from our own build output, not user input
		link.innerHTML = social.svg;
		link.firstElementChild?.setAttribute("class", "social-icon");
		return link;
	}

	async function refreshFooter() {
		const info = await loadBuildInfo();
		if (!info) return;

		const builtAt = document.querySelector<HTMLElement>("[data-footer-built-at]");
		if (builtAt && builtAt.dataset.footerBuiltAt !== info.builtAt) {
			builtAt.dataset.footerBuiltAt = info.builtAt;
			builtAt.textContent = formatBuildTime(
				new Date(info.builtAt),
				builtAt.dataset.timezone ?? "Asia/Kolkata",
			);
		}

		const socials = document.querySelector<HTMLElement>("[data-footer-socials]");
		if (socials && info.socials.length > 0) {
			socials.replaceChildren(...info.socials.map(renderSocialLink));
		}
	}

	document.addEventListener("astro:page-load", refreshFooter);
</script>
