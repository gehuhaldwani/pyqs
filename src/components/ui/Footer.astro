---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import siteConfig, { SOCIALS } from "@/configs/site.config";
import GithubButton from "../widgets/GithubButton.astro";
import Doodle from "./Doodle.astro";
import FooterBuildTime from "./FooterBuildTime.svelte";
import FooterSocials from "./FooterSocials.svelte";
import NavLink from "./NavLink.astro";

interface Props extends HTMLAttributes<"footer"> {}

const { class: className, ...props } = Astro.props;

const builtAt = new Date();
---

<!-- AdSense Auto ads skip elements that already have this status, so it keeps ads out of the footer. -->
<footer
	data-adsbygoogle-status="done"
	class:list={["mt-16 rounded-t-[2.5rem] border-t border-white/10 bg-[#1c1c1e] text-white", className]}
	{...props}
>
	<div class="relative mx-auto h-full w-full max-w-6xl px-6 py-12 sm:px-10">
		<Doodle name="squiggle" class="absolute top-6 right-10 hidden w-32 text-brand-yellow sm:block" />
		<div class="grid grid-cols-1 gap-10 md:grid-cols-3">
			<div class="md:col-span-2">
				<div class="inline-block -rotate-1 rounded-2xl bg-sticky-yellow px-5 py-4 text-sticky-ink shadow-lift">
					<p class="text-lg">
						Maintained by <span class="font-excalifont text-xl">{siteConfig.footer.maintainer.name}</span>
					</p>
					<p class="font-excalifont text-sm opacity-80">
						{siteConfig.footer.maintainer.designation}
					</p>
				</div>

				<p class="mt-6">
					<NavLink
						class="inline-flex items-center gap-1 rounded-full bg-white px-4 py-2 font-semibold text-sticky-ink hover:bg-brand-yellow hover:no-underline"
						href={siteConfig.footer.maintainer.support}
						external
						externalIcon
					>
						Support my work
					</NavLink>
				</p>

				<FooterSocials client:idle>
					{
						SOCIALS.map((social) => (
							<NavLink href={social.url} external aria-label={social.name}>
								<Icon name={social.iconify} class="social-icon" aria-hidden="true" />
							</NavLink>
						))
					}
				</FooterSocials>
				<p class="mt-6 max-w-prose text-white/70">{siteConfig.site.description}</p>
			</div>
			<div>
				<h2 class="font-excalifont text-xl text-brand-yellow">Quick links</h2>
				<ul class="mt-3 space-y-2 text-white/80">
					<li>
						<GithubButton />
					</li>
					{
						siteConfig.footer.links.map((link) => (
							<li>
								<NavLink
									href={link.url}
									external={link.type === "external"}
									externalIcon
									class="inline-flex items-center gap-1 hover:text-white"
								>
									{link.name}
								</NavLink>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="mt-12 flex flex-col items-center gap-1 border-t border-white/10 pt-6 text-sm text-white/60">
			<p>
				Built with <NavLink
					href="https://astro.build"
					external
					class="text-white hover:decoration-2"
					aria-label="Astro"
				>
					<Icon name="astro" class="inline" aria-hidden="true" />
				</NavLink>
			</p>
			<p>
				Last updated on <FooterBuildTime
					client:idle
					builtAt={builtAt.toISOString()}
					timezone={siteConfig.site.timezone}
				/>
			</p>
		</div>
	</div>
</footer>
