---
interface Props {
	src: string;
}

const { src } = Astro.props;
---

<div
	id="pdf-viewer"
	class="w-full h-dvh pt-[env(safe-area-inset-top)] pr-[env(safe-area-inset-right)] pb-[env(safe-area-inset-bottom)] pl-[env(safe-area-inset-left)]"
	data-src={src}
></div>

<script>
	// Docs: https://www.embedpdf.com/docs/snippet/introduction

	import EmbedPDF from "@embedpdf/snippet";
	import { loadAnnotations, saveAnnotations } from "@/lib/annotation-store";
	import { navigate } from "astro:transitions/client";

	const DISABLED_CATEGORIES = [
		"document-open",
		"document-close",
		"document-capture",
		"document-protect",
		"document-fullscreen",
		"redaction",
		"tools",
		"form",
		"insert",
	];
	const CLOSE_COMMAND_ID = "custom.close-viewer";
	const CLOSE_ICON_ID = "close-x";
	const EXPORT_BUTTON = {
		type: "command-button",
		id: "document-export-button",
		commandId: "document:export",
		variant: "icon",
	};
	const CLOSE_BUTTON = {
		type: "command-button",
		id: "close-viewer-button",
		commandId: CLOSE_COMMAND_ID,
		variant: "icon",
	};
	const CENTER_ITEM_IDS = ["zoom-menu-button", "zoom-toolbar"];

	// The theme option only covers colors, so the whiteboard canvas and pill buttons go into the viewer's shadow root.
	// Site variables such as --canvas-dot still reach it, because custom properties inherit into shadow DOM.
	const VIEWER_CSS = `
		.bg-bg-app {
			background-image: radial-gradient(var(--canvas-dot) 1.2px, transparent 1.4px);
			background-size: 24px 24px;
		}
		button.rounded-md {
			border-radius: 9999px;
		}
	`;

	const embedPdfColors = {
		accent: {
			primary: "var(--foreground)",
			primaryHover:
				"color-mix(in srgb, var(--foreground) 90%, transparent)",
			primaryActive:
				"color-mix(in srgb, var(--foreground) 80%, transparent)",
			primaryLight: "var(--marker)",
			primaryForeground: "var(--background)",
		},
		background: {
			app: "var(--background)",
			surface: "var(--card)",
			surfaceAlt: "var(--muted)",
			elevated: "var(--popover)",
			overlay: "color-mix(in srgb, var(--foreground) 24%, transparent)",
			input: "var(--input)",
		},
		foreground: {
			primary: "var(--foreground)",
			secondary: "var(--muted-foreground)",
			muted: "var(--muted-foreground)",
			disabled:
				"color-mix(in srgb, var(--muted-foreground) 72%, transparent)",
			onAccent: "var(--background)",
		},
		interactive: {
			hover: "var(--accent)",
			active: "color-mix(in srgb, var(--accent) 78%, var(--foreground))",
			selected: "var(--marker)",
			focus: "var(--outline)",
			focusRing: "color-mix(in srgb, var(--outline) 28%, transparent)",
		},
		border: {
			default: "var(--border)",
			subtle: "color-mix(in srgb, var(--border) 65%, var(--background))",
			strong: "color-mix(in srgb, var(--border) 78%, var(--foreground))",
		},
		state: {
			error: "var(--error)",
			errorLight:
				"color-mix(in srgb, var(--error) 16%, var(--background))",
			warning: "var(--warning)",
			warningLight:
				"color-mix(in srgb, var(--warning) 18%, var(--background))",
			success: "var(--success)",
			successLight:
				"color-mix(in srgb, var(--success) 18%, var(--background))",
			info: "var(--info)",
			infoLight: "color-mix(in srgb, var(--info) 18%, var(--background))",
		},
		tooltip: {
			background: "var(--foreground)",
			foreground: "var(--background)",
		},
		scrollbar: {
			track: "var(--muted)",
			thumb: "var(--border)",
			thumbHover: "var(--muted-foreground)",
		},
	};

	// The parts of EmbedPDF's annotation capability used below. The plugin package isn't a direct dependency.
	type TransferItem = { annotation: { id: string } };
	type AnnotationEvent =
		| { type: "loaded" }
		| { type: "create" | "update" | "delete"; annotation: { id: string } };
	type AnnotationApi = {
		onAnnotationEvent: (listener: (event: AnnotationEvent) => void) => unknown;
		importAnnotations: (items: TransferItem[]) => void;
		exportAnnotations: () => { toPromise: () => Promise<TransferItem[]> };
		// Every page gets a key once the PDF's own annotations have loaded.
		getState: () => { pages: Record<number, string[]> };
	};

	// Saves the reader's own annotations for this paper and puts them back when it opens again.
	// Annotations that came inside the PDF are left out, so they aren't added twice on the next visit.
	function keepAnnotations(api: AnnotationApi, key: string) {
		const ownIds = new Set<string>();
		let restored = false;
		let saveTimer: ReturnType<typeof setTimeout> | undefined;

		async function save() {
			clearTimeout(saveTimer);
			saveTimer = undefined;
			const items = await api.exportAnnotations().toPromise();
			await saveAnnotations(
				key,
				items.filter((item) => ownIds.has(item.annotation.id)),
			);
		}

		async function restore() {
			if (restored) return;
			restored = true;
			const saved = await loadAnnotations<TransferItem>(key);
			for (const item of saved) ownIds.add(item.annotation.id);
			if (saved.length > 0) api.importAnnotations(saved);
		}

		api.onAnnotationEvent((event) => {
			if (event.type === "loaded") {
				void restore();
				return;
			}
			// Events before the restore come from the PDF's own annotations.
			if (!restored) return;
			if (event.type === "create") ownIds.add(event.annotation.id);
			if (!ownIds.has(event.annotation.id)) return;
			if (event.type === "delete") ownIds.delete(event.annotation.id);

			clearTimeout(saveTimer);
			saveTimer = setTimeout(save, 400);
		});

		// A cached PDF can finish loading before this listener is attached, so its "loaded" event is already gone.
		if (Object.keys(api.getState().pages).length > 0) void restore();

		// Save right away when the reader leaves, so the last change isn't lost to the delay.
		const flush = () => {
			if (saveTimer !== undefined) void save();
		};
		document.addEventListener("astro:before-preparation", flush, { once: true });
		window.addEventListener("pagehide", flush, { once: true });
	}

	async function setupViewer() {
		const container = document.getElementById("pdf-viewer");

		// EmbedPDF cleans up when its element leaves the DOM.
		// This check only stops a second init on the same container.
		if (container && !container.dataset.initialized) {
			container.dataset.initialized = "true";

			const viewer = EmbedPDF.init({
				type: "container",
				target: container,
				src: container.dataset.src,
				disabledCategories: DISABLED_CATEGORIES,
				// The site font is already loaded, so the viewer skips its own Open Sans request.
				// The shadow root has its own --font-sans, so this names the site font directly.
				fonts: {
					ui: {
						family: "var(--font-figtree), system-ui, sans-serif",
						stylesheetUrl: null,
					},
				},
				theme: {
					// Follow the site toggle, which sets the .dark class, rather than the OS.
					preference: document.documentElement.classList.contains("dark")
						? "dark"
						: "light",
					light: embedPdfColors,
					dark: embedPdfColors,
				},
			});

			if (!viewer) return;

			const shadowRoot = container.querySelector("embedpdf-container")?.shadowRoot;
			if (shadowRoot) {
				const sheet = new CSSStyleSheet();
				sheet.replaceSync(VIEWER_CSS);
				shadowRoot.adoptedStyleSheets = [...shadowRoot.adoptedStyleSheets, sheet];
			}

			const registry = await viewer.registry;

			const annotationPlugin = registry.getPlugin("annotation");
			if (annotationPlugin?.provides && container.dataset.src) {
				keepAnnotations(
					annotationPlugin.provides() as AnnotationApi,
					container.dataset.src,
				);
			}

			const commandsPlugin = registry.getPlugin("commands");
			const uiPlugin = registry.getPlugin("ui");

			if (
				!commandsPlugin ||
				!commandsPlugin.provides ||
				!uiPlugin ||
				!uiPlugin.provides
			) {
				return;
			}

			const commands = commandsPlugin.provides();
			const ui = uiPlugin.provides();

			viewer.registerIcon(CLOSE_ICON_ID, {
				viewBox: "0 0 24 24",
				paths: [
					{
						d: "M18 6L6 18",
						stroke: "currentColor",
						fill: "none",
					},
					{
						d: "M6 6L18 18",
						stroke: "currentColor",
						fill: "none",
					},
				],
			});

			commands.registerCommand({
				id: CLOSE_COMMAND_ID,
				label: "Close",
				icon: CLOSE_ICON_ID,
				action: () => navigate("../"),
			});

			const schema = ui.getSchema();
			const toolbar = schema.toolbars["main-toolbar"];

			if (!toolbar) return;

			const items = JSON.parse(JSON.stringify(toolbar.items));
			let leftGroup;
			let centerGroup;
			let rightGroup;
			let spacer1;
			let spacer2;
			const remainingToolbarItems = [];

			for (const item of items) {
				switch (item.id) {
					case "left-group":
						leftGroup = item;
						continue;
					case "center-group":
						centerGroup = item;
						continue;
					case "right-group":
						rightGroup = item;
						continue;
					case "spacer-1":
						spacer1 = item;
						continue;
					case "spacer-2":
						spacer2 = item;
						continue;
				}

				remainingToolbarItems.push(item);
			}

			if (!leftGroup || !centerGroup || !rightGroup) return;

			const remainingLeftItems = [];

			for (const item of leftGroup.items) {
				if (item.id === "document-menu-button") {
					continue;
				}

				remainingLeftItems.push(item);
			}

			const centerItems = [];
			const remainingCenterItems = [];

			for (const item of centerGroup.items) {
				if (CENTER_ITEM_IDS.includes(item.id)) {
					centerItems.push(item);
				} else {
					remainingCenterItems.push(item);
				}
			}

			leftGroup.items = [];
			for (const item of remainingLeftItems) {
				if (item.type !== "divider") {
					leftGroup.items.push(item);
				}
			}
			let pageSettingsIndex = -1;
			for (const [index, item] of leftGroup.items.entries()) {
				if (item.id === "page-settings-button") {
					pageSettingsIndex = index;
					break;
				}
			}
			if (pageSettingsIndex === -1) {
				leftGroup.items.push(EXPORT_BUTTON);
			} else {
				leftGroup.items.splice(pageSettingsIndex + 1, 0, EXPORT_BUTTON);
			}
			centerGroup.items = [];
			for (const item of [...centerItems, ...remainingCenterItems]) {
				if (item.type !== "divider") {
					centerGroup.items.push(item);
				}
			}
			const existingRightItems = rightGroup.items;
			rightGroup.items = [];
			for (const item of existingRightItems) {
				if (item.type !== "divider") {
					rightGroup.items.push(item);
				}
			}
			rightGroup.items.push(CLOSE_BUTTON);

			const reorderedItems = [leftGroup];
			const filteredToolbarItems = [];
			for (const item of remainingToolbarItems) {
				if (item.type !== "divider") {
					filteredToolbarItems.push(item);
				}
			}

			if (spacer1) {
				reorderedItems.push(spacer1);
			}

			reorderedItems.push(centerGroup);

			if (spacer2) {
				reorderedItems.push(spacer2);
			}

			reorderedItems.push(...filteredToolbarItems, rightGroup);

			ui.mergeSchema({
				toolbars: {
					"main-toolbar": {
						...toolbar,
						items: reorderedItems,
						responsive: {
							...toolbar.responsive,
							breakpoints: {
								...toolbar.responsive?.breakpoints,
								// Phones have no room for every button, and the comments panel pushed the close button off screen.
								"pyqs-phone": {
									maxWidth: 640,
									hide: ["comment-button"],
								},
							},
						},
					},
				},
			});
		}
	}

	document.addEventListener("astro:page-load", setupViewer);
</script>
