---
import Breadcrumb from "@/components/starwind/breadcrumb";
import { Button } from "@/components/starwind/button";

interface Props {
	path: string;
	back?: boolean;
	// Label for the last crumb, instead of the last path segment
	current?: string;
}

const { path, back = true, current } = Astro.props;

type Crumb = {
	title: string;
	path: string;
};

const crumbs: Crumb[] = [];
let currentPath = "/";

for (const p of path.split("/")) {
	if (p) {
		currentPath += `${p}/`;
		crumbs.push({
			title: p,
			path: currentPath,
		});
	}
}
---

<Breadcrumb.Root
	class="select-none font-excalifont"
	transition:name="breadcrumbs"
>
	<Breadcrumb.List>
		<Button
			class="font-bold text-foreground"
			variant="outline"
			size="sm"
			disabled={!back}
			href="../"
			data-astro-prefetch="viewport"
			aria-label="Up a folder"
			title="Up a folder">↑</Button
		>
		{
			crumbs.map((crumb, index) => {
				if (index + 1 !== crumbs.length)
					return (
						<>
							<Breadcrumb.Item>
								<Breadcrumb.Link
									href={crumb.path}
									data-astro-prefetch="viewport"
									class="text-lg"
								>
									{crumb.title}
								</Breadcrumb.Link>
							</Breadcrumb.Item>
							<Breadcrumb.Separator>/</Breadcrumb.Separator>
						</>
					);
				return (
					<Breadcrumb.Item>
						<Breadcrumb.Page class="text-foreground font-medium text-lg">
							{current ?? crumb.title}
						</Breadcrumb.Page>
					</Breadcrumb.Item>
				);
			})
		}
	</Breadcrumb.List>
</Breadcrumb.Root>
