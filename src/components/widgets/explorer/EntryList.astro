---
import Item from "@/components/starwind/item";
import { type DirEntry, isPyqFile } from "@/lib/content/schema";
import { comparePyqs } from "@/lib/pyqs";
import DirectoryEntry from "./DirectoryEntry.astro";
import EntryListContentBlock from "./EntryListContentBlock.astro";
import PdfEntry from "./PdfEntry.astro";
import UploadButton from "./UploadButton.astro";

interface Props {
	title: string;
	path: string;
	entry: DirEntry;
	capitalize?: boolean;
}

const { entry, capitalize = false, path, title } = Astro.props;

const dirs = entry.directories.toSorted((a, b) => a.name.localeCompare(b.name));
// Newest first
const pdfs = entry.files
	.filter(isPyqFile)
	.toSorted((a, b) => comparePyqs(b.pyq, a.pyq));
---

<div class="[&>*:not(:first-child)]:mt-4 select-none">
	{
		dirs.length > 0 && (
			<>
				<Item.Group>
					{dirs.map((dir) => (
						<>
							<DirectoryEntry entry={dir} {capitalize} />
							<Item.Separator />
						</>
					))}
				</Item.Group>

				<Item.Group>
					<EntryListContentBlock />
				</Item.Group>
			</>
		)
	}

	{
		pdfs.length > 0 && (
			<>
				<Item.Group>
					{pdfs.map((pdf) => (
						<>
							<PdfEntry entry={pdf} />
							<Item.Separator />
						</>
					))}
				</Item.Group>

				<Item.Group>
					<EntryListContentBlock />
				</Item.Group>
			</>
		)
	}

	{
		pdfs.length > 0 && (
			<div class="flex justify-center">
				<UploadButton title={title} path={path} />
			</div>
		)
	}
</div>
