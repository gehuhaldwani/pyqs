---
// AdSense ad unit "PYQs Explorer List". Head.astro fills slots as they near the viewport.
interface Props {
	// "banner" is a short strip for spots above the content. "auto" lets AdSense pick the size.
	format?: "auto" | "banner";
	class?: string;
}

const { format = "auto", class: className } = Astro.props;
const banner = format === "banner";
---

<aside class:list={["ad-slot", className]} aria-label="Advertisement">
	<p class="scribble mb-1 text-sm">advertisement</p>
	<!-- Reserved height keeps the content below from jumping when the ad loads. -->
	<!-- A responsive unit with a CSS height and no data-ad-format fits that height, so the banner can't grow tall on phones. -->
	<ins
		class:list={[
			"adsbygoogle block w-full overflow-hidden rounded-2xl",
			banner ? "h-[100px] sm:h-[90px]" : "min-h-[250px]",
		]}
		data-ad-client="ca-pub-9523971842257474"
		data-ad-slot="7953820280"
		data-ad-format={banner ? undefined : "auto"}
		data-full-width-responsive={banner ? "false" : "true"}></ins>
</aside>
