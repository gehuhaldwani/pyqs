---
import { Icon } from "astro-icon/components";
import { displayName, type FileEntry } from "@/lib/content/schema";
import { addForwardSlashAndBaseUrl } from "@/utils/site-url";

interface Props {
	entry: FileEntry;
}

const { entry } = Astro.props;
---

<a
	href={addForwardSlashAndBaseUrl(entry.path)}
	data-astro-prefetch="viewport"
	class="group sticky-note note-hover focus-ring flex items-center gap-3 bg-sticky-lavender p-4"
>
	<span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-white/60">
		<Icon name="mdi:file-document-outline" class="size-6" aria-hidden="true" />
	</span>
	<span class="min-w-0 flex-1 font-semibold leading-snug hyphens-auto wrap-break-word">{displayName(entry)}</span>
	<span
		class="font-excalifont text-xl opacity-50 transition-transform group-hover:translate-x-1 group-hover:opacity-100"
		aria-hidden="true">→</span
	>
</a>
