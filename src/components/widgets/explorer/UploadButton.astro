---
import { Button } from "@/components/starwind/button";
import { EXTERNAL_LINK_ATTRIBUTES, uploaderUrl } from "@/utils/url";

interface Props {
	title: string;
	path: string;
}

const { path, title } = Astro.props;
---

<Button
	href={uploaderUrl(path, title)}
	{...EXTERNAL_LINK_ATTRIBUTES}
	variant="default"
>
	<p class="wrap-break-word whitespace-normal text-center">
		Upload PYQs to <span class="font-bold font-excalifont">“{title}”</span>
	</p>
</Button>
