---
import { Icon } from "astro-icon/components";
import type { PyqFileEntry } from "@/lib/content/schema";
import { formatPyqDate, formatPyqExam, formatPyqSubjects } from "@/lib/pyqs";
import { EXAM_TYPE_COLORS } from "@/lib/sticky";
import { addForwardSlashAndBaseUrl } from "@/utils/site-url";

interface Props {
	entry: PyqFileEntry;
}

const { entry } = Astro.props;
const { pyq } = entry;
---

<a
	href={addForwardSlashAndBaseUrl(entry.path)}
	data-astro-prefetch="hover"
	data-exam={pyq.type}
	class="group paper-card note-hover focus-ring flex items-center gap-4 p-4"
>
	<span
		class="grid size-12 shrink-0 place-items-center rounded-2xl bg-muted text-pdf transition-transform motion-safe:group-hover:-rotate-6"
	>
		<Icon name="pdf" class="size-7" aria-hidden="true" />
	</span>
	<span class="flex min-w-0 flex-1 flex-col gap-1.5">
		<span class="line-clamp-2 text-base font-bold leading-snug wrap-break-word" translate="no">
			{formatPyqSubjects(pyq)}
		</span>
		<span class="flex flex-wrap items-center gap-1.5">
			<span class:list={["pill-tag text-sticky-ink", EXAM_TYPE_COLORS[pyq.type]]}>
				{formatPyqExam(pyq)}
			</span>
			<span class="text-sm text-muted-foreground">{formatPyqDate(pyq)}</span>
		</span>
	</span>
	<span
		class="font-excalifont text-xl text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-foreground"
		aria-hidden="true">→</span
	>
</a>
