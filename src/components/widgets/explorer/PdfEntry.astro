---
import Item from "@/components/starwind/item";
import type { PyqFileEntry } from "@/lib/content/schema";
import { formatPyqDate, formatPyqTitle } from "@/lib/pyqs";
import { addForwardSlashAndBaseUrl } from "@/utils/url";
import { Icon } from "astro-icon/components";

interface Props {
	entry: PyqFileEntry;
}

const { entry } = Astro.props;
---

<Item.Root
	as="a"
	href={addForwardSlashAndBaseUrl(entry.path)}
	data-astro-prefetch="hover"
	class="[a]:active:bg-accent/50"
>
	<Item.Media variant="image">
		<Icon name="pdf" width={32} height={32} class:list={"text-red-500"} />
	</Item.Media>
	<Item.Content>
		<Item.Title>{formatPyqTitle(entry.pyq)}</Item.Title>
		<Item.Description>
			{formatPyqDate(entry.pyq)}
		</Item.Description>
	</Item.Content>
</Item.Root>
