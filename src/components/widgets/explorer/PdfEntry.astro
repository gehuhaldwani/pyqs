---
import { Icon } from "astro-icon/components";
import Item from "@/components/starwind/item";
import type { PyqFileEntry } from "@/lib/content/schema";
import { formatPyqDate, formatPyqTitle } from "@/lib/pyqs";
import { addForwardSlashAndBaseUrl } from "@/utils/site-url";

interface Props {
	entry: PyqFileEntry;
}

const { entry } = Astro.props;
---

<Item.Root
	as="a"
	href={addForwardSlashAndBaseUrl(entry.path)}
	data-astro-prefetch="hover"
	class="item-link"
>
	<Item.Media variant="image">
		<Icon
			name="pdf"
			width={32}
			height={32}
			class="text-pdf"
			aria-hidden="true"
		/>
	</Item.Media>
	<Item.Content>
		<Item.Title translate="no">{formatPyqTitle(entry.pyq)}</Item.Title>
		<Item.Description>
			{formatPyqDate(entry.pyq)}
		</Item.Description>
	</Item.Content>
</Item.Root>
