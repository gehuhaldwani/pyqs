---
import { Icon } from "astro-icon/components";
import type { DirSummary } from "@/lib/content/schema";
import { stickyColor, stickyTilt } from "@/lib/sticky";
import { addForwardSlashAndBaseUrl } from "@/utils/site-url";
import { toTitleCase } from "@/utils/string";

interface Props {
	entry: DirSummary;
	capitalize?: boolean;
	// Its place in the list, which staggers its entrance.
	index?: number;
}

const { entry: dir, capitalize = false, index = 0 } = Astro.props;

function getDirTitle(title: string, capitalize: boolean) {
	return capitalize || ["OTHERS", "OLD", "END", "MID"].includes(title)
		? title
		: toTitleCase(title);
}

// Archive folders are quieter so the current ones stand out.
const isArchive = dir.name === "OTHERS" || dir.name === "OLD";
---

<a
	href={addForwardSlashAndBaseUrl(dir.path)}
	data-astro-prefetch="viewport"
	style={`--i: ${index}`}
	class:list={[
		"group note-hover focus-ring flex min-h-28 flex-col justify-between gap-4 p-4 motion-safe:animate-rise sm:min-h-32 sm:p-5",
		isArchive
			? "relative rounded-3xl border-2 border-dashed border-input bg-card text-muted-foreground transition-[translate,scale,box-shadow] duration-200"
			: ["sticky-note", stickyColor(dir.name), stickyTilt(dir.name)],
	]}
>
	{
		!isArchive && (
			<span
				class="absolute -top-2.5 left-1/2 h-5 w-14 -translate-x-1/2 rotate-3 rounded-sm bg-white/55 shadow-sm"
				aria-hidden="true"
			/>
		)
	}
	<!-- The arrow sits beside the icon, so the title gets the full width of narrow two-column notes. -->
	<span class="flex items-center justify-between gap-2">
		<Icon
			name={isArchive ? "mdi:archive-outline" : "mdi:folder-outline"}
			class="size-6 opacity-60"
			aria-hidden="true"
		/>
		<span
			class="font-excalifont text-xl leading-none opacity-50 transition-transform group-hover:translate-x-1 group-hover:opacity-100"
			aria-hidden="true">→</span
		>
	</span>
	<span
		class="min-w-0 text-base leading-tight font-bold hyphens-auto wrap-break-word sm:text-xl"
	>
		{getDirTitle(dir.name.toUpperCase(), capitalize)}
	</span>
</a>
