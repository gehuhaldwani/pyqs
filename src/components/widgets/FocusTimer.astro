---
// A Pomodoro timer: 25 minutes of focus, then a 5 minute break. It keeps running across pages.
import Doodle from "@/components/ui/Doodle.astro";
---

<div class="flex items-center gap-1" data-focus-timer>
	<button
		type="button"
		class="inline-flex h-10 items-center gap-1.5 rounded-full border bg-card px-3 text-sm font-semibold shadow-soft transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-outline data-[phase=break]:bg-sticky-mint data-[phase=break]:text-sticky-ink data-[phase=focus]:bg-sticky-coral data-[phase=focus]:text-sticky-ink"
		data-focus-toggle
		title="Focus timer: 25 min study, 5 min break"
	>
		<Doodle name="tomato" class="size-5 shrink-0" stroke-width="2" />
		<span class="tabular-nums" data-focus-label>Focus</span>
	</button>
	<button
		type="button"
		class="hidden size-8 items-center justify-center rounded-full text-muted-foreground hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-outline data-visible:inline-flex"
		data-focus-reset
		aria-label="Reset focus timer"
		title="Reset"
	>
		<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>
	<span class="sr-only" aria-live="polite" data-focus-status></span>
</div>

<script>
	type Phase = "focus" | "break";
	type TimerState = {
		phase: Phase;
		// Set while running.
		endsAt: number | null;
		// Set while paused.
		remaining: number | null;
	};

	const KEY = "pyqs-focus-timer";
	const DURATIONS: Record<Phase, number> = {
		focus: 25 * 60_000,
		break: 5 * 60_000,
	};

	let state: TimerState | null = load();
	let lastAnnounced = "";

	function load(): TimerState | null {
		try {
			const raw = localStorage.getItem(KEY);
			return raw ? (JSON.parse(raw) as TimerState) : null;
		} catch {
			return null;
		}
	}

	function save() {
		try {
			if (state) localStorage.setItem(KEY, JSON.stringify(state));
			else localStorage.removeItem(KEY);
		} catch {
			// Private windows can block storage. The timer still works on this page.
		}
	}

	function remaining(): number {
		if (!state) return 0;
		if (state.endsAt !== null) return Math.max(0, state.endsAt - Date.now());
		return state.remaining ?? DURATIONS[state.phase];
	}

	function format(ms: number): string {
		const total = Math.ceil(ms / 1000);
		const m = Math.floor(total / 60);
		const s = total % 60;
		return `${m}:${String(s).padStart(2, "0")}`;
	}

	function announce(text: string) {
		if (text === lastAnnounced) return;
		lastAnnounced = text;
		const status = document.querySelector<HTMLElement>("[data-focus-status]");
		if (status) status.textContent = text;
	}

	function render() {
		const root = document.querySelector<HTMLElement>("[data-focus-timer]");
		if (!root) return;
		const toggle = root.querySelector<HTMLElement>("[data-focus-toggle]");
		const label = root.querySelector<HTMLElement>("[data-focus-label]");
		const reset = root.querySelector<HTMLElement>("[data-focus-reset]");
		if (!toggle || !label || !reset) return;

		if (!state) {
			label.textContent = "Focus";
			toggle.removeAttribute("data-phase");
			toggle.setAttribute("aria-label", "Start a 25 minute focus timer");
			reset.removeAttribute("data-visible");
			return;
		}

		const running = state.endsAt !== null;
		const time = format(remaining());
		const name = state.phase === "focus" ? "Focus" : "Break";
		label.textContent = running ? time : `${time} paused`;
		toggle.dataset.phase = state.phase;
		toggle.setAttribute(
			"aria-label",
			`${name} timer, ${time} left. ${running ? "Pause" : "Resume"}`,
		);
		reset.setAttribute("data-visible", "");
	}

	function tick() {
		if (state?.endsAt != null && remaining() === 0) {
			if (state.phase === "focus") {
				state = { phase: "break", endsAt: Date.now() + DURATIONS.break, remaining: null };
				announce("Focus done. Take a 5 minute break.");
			} else {
				state = null;
				announce("Break over. Ready for another round?");
			}
			save();
		}
		render();
	}

	function toggle() {
		if (!state) {
			state = { phase: "focus", endsAt: Date.now() + DURATIONS.focus, remaining: null };
			announce("Focus timer started, 25 minutes.");
		} else if (state.endsAt !== null) {
			state = { ...state, endsAt: null, remaining: remaining() };
			announce("Timer paused.");
		} else {
			state = { ...state, endsAt: Date.now() + remaining(), remaining: null };
			announce("Timer resumed.");
		}
		save();
		render();
	}

	function reset() {
		state = null;
		announce("Timer reset.");
		save();
		render();
	}

	// The client router swaps the header on each page, so the buttons are wired up again after every navigation.
	document.addEventListener("astro:page-load", () => {
		document.querySelector("[data-focus-toggle]")?.addEventListener("click", toggle);
		document.querySelector("[data-focus-reset]")?.addEventListener("click", reset);
		render();
	});

	// Another tab can start or stop the timer.
	window.addEventListener("storage", (event) => {
		if (event.key !== KEY) return;
		state = load();
		render();
	});

	setInterval(tick, 1000);
</script>
