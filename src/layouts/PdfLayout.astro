---
import PdfViewer from "@/components/widgets/PdfViewer.astro";
import BaseLayout from "./BaseLayout.astro";
import siteConfig from "@/configs/site.config";
import type { FsEntry } from "@/lib/content/schema";
import { githubRawUrl, pdfThumbnailPath } from "@/utils/links";

interface Props {
    entry: FsEntry<"file">;
}

const { entry } = Astro.props;
const { githubRepo, contentBranch, thumbnailsBranch } = siteConfig.site;

const src = githubRawUrl(githubRepo, contentBranch, entry.path);
const thumbnail = githubRawUrl(githubRepo, thumbnailsBranch, pdfThumbnailPath(entry.path));
---

<BaseLayout
    title={entry.name.toUpperCase().split("_").join(" ")}
    description={entry.path.split("/").slice(1).join(" > ")}
    ogImageUrl={new URL(thumbnail)}
>
    <PdfViewer {src} />
</BaseLayout>
