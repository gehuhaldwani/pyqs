---
import FocusTimer from "@/components/widgets/FocusTimer.astro";
import PdfViewer from "@/components/widgets/PdfViewer.svelte";
import siteConfig from "@/configs/site.config";
import { displayName, type FileEntry } from "@/lib/content/schema";
import { formatPyqDetail, formatPyqSubjects, formatPyqTitle } from "@/lib/pyqs";
import { githubRawUrl, pdfThumbnailPath } from "@/utils/url";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	entry: FileEntry;
}

const { entry } = Astro.props;
const { githubRepo, contentBranch, thumbnailsBranch } = siteConfig.site;

const src = githubRawUrl(githubRepo, contentBranch, entry.path);
const thumbnail = githubRawUrl(
	githubRepo,
	thumbnailsBranch,
	pdfThumbnailPath(entry.path),
);

const pageTitle = entry.name.toUpperCase().split("_").join(" ");
const title = entry.pyq ? formatPyqTitle(entry.pyq) : displayName(entry);
// The star saves the same text a paper's card shows in a folder.
const starTitle = entry.pyq ? formatPyqSubjects(entry.pyq) : displayName(entry);
const starDetail = entry.pyq ? formatPyqDetail(entry.pyq) : undefined;
---

<BaseLayout
    title={pageTitle}
    description={entry.path.split("/").slice(1).join(" > ")}
    ogImageUrl={new URL(thumbnail)}
    lockZoom
    preconnect={[new URL(src).origin]}
    ads={false}
>
    <h1 class="sr-only">{title}</h1>
    <PdfViewer
        {src}
        path={entry.path}
        title={starTitle}
        detail={starDetail}
        client:load
    />

    <div
        class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-50 max-[400px]:bottom-[calc(4.5rem+env(safe-area-inset-bottom))]"
        transition:name="focus-timer"
    >
        <FocusTimer />
    </div>
</BaseLayout>
