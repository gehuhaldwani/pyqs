---
// Page for a markdown doc. It uses the folder page frame without the entry list.
import { type CollectionEntry, render } from "astro:content";
import Prose from "@/components/partials/Prose.astro";
import { displayName, type FileEntry } from "@/lib/content/schema";
import { addForwardSlashAndBaseUrl } from "@/utils/site-url";
import BrowseLayout from "./BrowseLayout.astro";

interface Props {
	// render() needs the collection entry for the markdown body.
	entry: CollectionEntry<"fs">;
	doc: FileEntry;
}

const { entry, doc } = Astro.props;

const title = displayName(doc);
const { Content, headings } = await render(entry);
const hasOwnHeading = headings.some((heading) => heading.depth === 1);
---

<BrowseLayout
	{title}
	path={addForwardSlashAndBaseUrl(doc.path)}
	current={title}
	heading={!hasOwnHeading}
>
	<Prose class="my-10">
		<Content />
	</Prose>
</BrowseLayout>
