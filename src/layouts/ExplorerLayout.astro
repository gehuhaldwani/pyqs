---
import PageLayout from "./PageLayout.astro";
import { addForwardSlashAndBaseUrl } from "@/utils/url";
import PathCrumbs from "@/components/widgets/explorer/PathCrumbs.astro";
import { base } from "astro:config/server";
import Separator from "@/components/starwind/separator";
import EntryList from "@/components/widgets/explorer/EntryList.astro";
import { render, type CollectionEntry } from "astro:content";
import type { DirEntry } from "@/lib/content/schema";
import HomePageBanner from "@/components/widgets/HomePageBanner.astro";
import Prose from "@/components/partials/Prose.astro";
import EntryListContentBlock from "@/components/widgets/explorer/EntryListContentBlock.astro";

interface Props {
	// The collection entry is needed to render the folder's index.md
	entry: CollectionEntry<"fs">;
	dir: DirEntry;
}

const { entry, dir } = Astro.props;

const isHomePage = Astro.url.pathname === base;

const path: string = addForwardSlashAndBaseUrl(dir.path);
const pathList = path.split("/").filter((element) => element);

let title: string = dir.name.toUpperCase();

if (["MID", "END", "OTHERS"].includes(title) || title.includes("YEAR ")) {
	title = pathList.splice(-2).join(" > ");
} else if (["OLD"].includes(title) || title.includes("SEM ")) {
	title = pathList.splice(-3).join(" > ");
}

const { Content } = await render(entry);
---

<PageLayout title={title}>
	{isHomePage && <HomePageBanner />}

	<EntryListContentBlock />

	<Separator class="my-4" />

	<PathCrumbs {path} back={!isHomePage} />

	<Separator class="my-4" />

	<EntryList entry={dir} {path} {title} capitalize={isHomePage} />

	<Prose class="my-10">
		<Content />
	</Prose>
</PageLayout>
