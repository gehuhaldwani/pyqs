---
// Picks the page layout for a file by its kind (set by the loader rules).
import type { CollectionEntry } from "astro:content";
import Alert from "@/components/starwind/alert";
import siteConfig from "@/configs/site.config";
import type { FileEntry } from "@/lib/content/schema";
import { githubRawUrl } from "@/utils/url";
import DocLayout from "./DocLayout.astro";
import PdfLayout from "./PdfLayout.astro";

interface Props {
	entry: CollectionEntry<"fs">;
	file: FileEntry;
}

const { entry, file } = Astro.props;

const downloadUrl = githubRawUrl(
	siteConfig.site.githubRepo,
	siteConfig.site.contentBranch,
	file.path,
);
---

{file.kind === "pdf" && <PdfLayout entry={file} />}

{file.kind === "doc" && <DocLayout {entry} doc={file} />}

{
	file.kind === "file" && (
		<Alert.Root variant="error">
			<Alert.Title>Preview not supported</Alert.Title>
			<Alert.Description>
				<p>
					Sorry, this file format (
					<span class="font-mono font-bold">{file.extension}</span>) is
					not supported for preview.
				</p>
				<p>
					You can download the file directly by clicking
					<a href={downloadUrl} class="text-primary underline">here</a>.
				</p>
			</Alert.Description>
		</Alert.Root>
	)
}
