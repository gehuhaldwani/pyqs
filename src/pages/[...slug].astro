---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import ExplorerLayout from "@/layouts/ExplorerLayout.astro";
import FileLayout from "@/layouts/FileLayout.astro";

export const getStaticPaths: GetStaticPaths = async () => {
	const entries = await getCollection("fs");
	return entries.map((entry) => ({
		params: {
			slug: entry.data.path,
		},
		props: {
			entry: entry,
		},
		// Incremental builds reuse a page's previous output while its cacheKey stays the same.
		// The loader changes the digest whenever the entry's data or markdown changes.
		cacheKey: entry.digest === undefined ? undefined : String(entry.digest),
	}));
};

interface Props {
	entry: CollectionEntry<"fs">;
}

const { entry } = Astro.props;
---

{entry.data.type === "dir" && <ExplorerLayout {entry} dir={entry.data} />}
{entry.data.type === "file" && <FileLayout {entry} file={entry.data} />}
