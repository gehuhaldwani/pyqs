---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import ExplorerLayout from "@/layouts/ExplorerLayout.astro";
import FileLayout from "@/layouts/FileLayout.astro";

export const getStaticPaths: GetStaticPaths = async () => {
	const entries = await getCollection("fs");
	return entries.map((entry) => ({
		params: {
			slug: entry.data.path,
		},
		props: {
			entry: entry,
		},
		// Lets experimental.incrementalBuild reuse the previous output when the
		// entry is unchanged. The fs loader updates the digest whenever an
		// entry's data (including a folder's listing or index.md) changes.
		cacheKey: entry.digest === undefined ? undefined : String(entry.digest),
	}));
};

interface Props {
	entry: CollectionEntry<"fs">;
}

const { entry } = Astro.props;
---

{entry.data.type === "dir" && <ExplorerLayout {entry} dir={entry.data} />}
{entry.data.type === "file" && <FileLayout file={entry.data} />}
